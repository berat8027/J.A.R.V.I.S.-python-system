# J.A.R.V.I.S. Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the real .env to version control

GEMINI_API_KEY=Write Gemini API

# Speech Settings
TTS_RATE=145
TTS_VOLUME=0.
STT_ENERGY_THRESHOLD=300
STT_PAUSE_THRESHOLD=0.8

# Vision Settings
CAMERA_INDEX=0
FACE_DETECTION_SCALE=1.1
FACE_DETECTION_NEIGHBORS=5

# Security
REQUIRE_CONFIRMATION_FOR_CRITICAL_ACTIONS=true
WHITELIST_ENABLED=true

# Autostart (Windows)
AUTOSTART_ON_BOOT=false

# Logging
LOG_LEVEL=INFO
LOG_ROTATION=10 MB

GEMINI_MODEL=gemini-3-flash-preview
